node_modules/
# Local scratch output is ignored, but the rendered recipe bundle under
# recipes/output/fullsend/ is the registry PR diff and MUST be committed.
# (Git cannot re-include a path whose parent dir is blanket-ignored, so glob
# the contents with recipes/output/* rather than the directory itself.)
recipes/output/*
!recipes/output/fullsend/
recipes/audit/
coverage/
.env
.env.*
.DS_Store
